PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_secret_here

#this is from aws elasticache cluster configuration, 
#you can find it in the AWS console under ElastiCache > Redis > Configuration > Primary Endpoint
#remove these comments when actually using the .env file, cause env file doesn't support comments..
REDIS_CLUSTER_NODES=your-elasticache-cluster-endpoint:6379	